APP_NAME=研发脉冲
APP_TIMEZONE=Asia/Shanghai

# 数据目录。单文件模式由程序自动指定（系统用户目录），容器模式固定为 /app/data
DATA_DIR=./data

# 数据库连接串；留空则使用数据目录下的 SQLite
# MySQL 形如：mysql+pymysql://user:password@host:3306/dbname?charset=utf8mb4
DATABASE_URL=

# 容器部署专用：留空则容器内用 SQLite；填 MySQL 连接串则连外部库
APP_DATABASE_URL=

# 加密仓库令牌与签发登录会话的主密钥；留空会自动生成并存到数据目录的 secret.key
# 换机器迁移数据时需要保持一致
APP_SECRET=

# 访问密码，留空表示不启用登录
APP_PASSWORD=
CORS_ORIGINS=*

# 大模型（OpenAI 兼容接口），也可在「设置」页面填写
# 形如 http://192.168.1.10:31000/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.3
# 大模型超时秒数，年报这类大证据量的报告需要更久
LLM_TIMEOUT=300

SYNC_INTERVAL_MINUTES=30
MAX_PAGES_PER_SYNC=20
FETCH_COMMIT_FILES=true
REQUEST_TIMEOUT=30
