APP_NAME=研发脉冲
APP_TIMEZONE=Asia/Shanghai
DATA_DIR=./data

# 本地开发用的数据库；留空则使用 data/worklog.db（SQLite）
DATABASE_URL=mysql+pymysql://root:ztt123456@localhost:3306/daylife?charset=utf8mb4

# 容器部署专用：留空则容器内用 SQLite；填 MySQL 连接串则连外部库
APP_DATABASE_URL=

# 用于加密仓库 Token 与签发登录会话，部署后请修改
APP_SECRET=change-me-to-a-long-random-string
# 访问密码，留空表示不启用登录
APP_PASSWORD=
CORS_ORIGINS=*

# 本地大模型（OpenAI 兼容接口），也可在「设置」页面填写
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.3
# 大模型超时秒数，年报这类大证据量的报告需要更久
LLM_TIMEOUT=300

SYNC_INTERVAL_MINUTES=30
MAX_PAGES_PER_SYNC=20
FETCH_COMMIT_FILES=true
REQUEST_TIMEOUT=30